# RPC (Helius recommended — generous free tier + DAS). Read-only is enough for monitor.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Public key of the wallet to watch (NO private key anywhere in this example).
WATCH_WALLET=

# DLMM (lb_clmm) pool / LB pair address to watch.
POOL_ADDRESS=

# For rebalance.ts: the wallet pubkey (owner) + the specific position to rebalance.
USER_PUBKEY=
POSITION_PUBKEY=

# Alert sink (optional). Slack/Discord/Telegram webhook; leave blank to log to stdout.
ALERT_WEBHOOK=

# Tunables (see skill/range-alerts.md and skill/rules/*.md)
INTERVAL_S=300
STALE_TICK_MAX_S=60
MAX_ACTIVE_BIN_SLIPPAGE=5
